{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "paratech-struts main",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd \"$(git rev-parse --show-toplevel)\" && npx serve -l $PORT ."],
      "autoPort": true
    },
    {
      "name": "fieldshore-v4-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5199", "--strictPort"],
      "port": 5199
    },
    {
      "name": "fieldshore-v4-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview", "--", "--port", "5198", "--strictPort"],
      "port": 5198
    }
  ]
}
