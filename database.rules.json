{
  "rules": {
    "departments": {
      "$deptId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || !data.child('members').exists())",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "inventory": {
          "$itemId": {
            ".validate": "newData.hasChildren(['model', 'quantity', 'available'])",
            "_meta": {
              "lastVerifiedAt": {
                ".validate": "newData.isNumber()"
              }
            }
          }
        },
        "apparatus": {
          "$appId": {
            ".validate": "newData.hasChildren(['name', 'type'])"
          }
        },
        "operations": {
          ".indexOn": ["status"],
          "$opId": {
            ".validate": "newData.hasChild('name') && newData.hasChild('status')",
            "_meta": {
              "roleHierarchyMigratedAt": {
                ".validate": "newData.isNumber()"
              }
            },
            "shorePoints": {
              "$spId": {
                "status": {
                  ".validate": "newData.isString() && newData.val().matches(/^(pending|process|strutplaced|cutting|runner|secured|returned)$/)"
                },
                "requiredLength": {
                  ".validate": "newData.isNumber() && newData.val() >= 12 && newData.val() <= 500"
                },
                "estimatedLoad": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000"
                },
                "label": {
                  ".validate": "newData.isString() && newData.val().length <= 200"
                },
                "group": {
                  ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
                },
                "assignedResource": {
                  ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
                },
                "division": {
                  ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= -50 && newData.val() <= 200) || (newData.isString() && newData.val().length <= 100)"
                },
                "divisionLegacyLabel": {
                  ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
                },
                "allocConflict": {
                  ".validate": "!newData.exists() || newData.isBoolean()"
                }
              }
            },
            "roles": {
              "$targetId": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              }
            },
            "customRoles": {
              "$idx": {
                ".validate": "newData.hasChildren(['id','name','abbr']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('abbr').isString() && newData.child('abbr').val().length <= 30"
              }
            },
            "customRolesById": {
              "$roleId": {
                ".validate": "newData.hasChildren(['name','abbr']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('abbr').isString() && newData.child('abbr').val().length <= 30",
                "assignedApparatusById": {
                  "$appId": {
                    ".validate": "newData.isBoolean()"
                  }
                }
              }
            },
            "externalEquipment": {
              "$itemId": {
                "available": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && (!newData.parent().child('quantity').exists() || newData.val() <= newData.parent().child('quantity').val())"
                },
                "quantity": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "_meta": {
                  "lastVerifiedAt": {
                    ".validate": "newData.isNumber()"
                  }
                }
              }
            },
            "hazards": {
              "$hazardId": {
                ".validate": "newData.hasChildren(['type','location','severity','reportedAt']) && newData.child('location').isString() && newData.child('location').val().length <= 200 && newData.child('type').isString() && newData.child('severity').isString() && newData.child('severity').val().matches(/^(low|medium|high)$/)",
                "notes": {
                  ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)"
                }
              }
            }
          }
        }
      }
    },
    "feedback": {
      ".read": "auth != null",
      "$feedbackId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['category', 'text', 'timestamp'])"
      }
    },
    "diagnostics": {
      "sync": {
        "$logId": {
          ".write": "auth != null",
          ".validate": "newData.hasChild('ts') && newData.hasChild('event')"
        }
      }
    },
    "config": {
      ".read": true,
      "minAppVersion": {
        ".write": false,
        ".validate": "newData.isString() && newData.val().matches(/^[0-9]+\\.[0-9]+\\.[0-9]+$/)"
      }
    },
    "orgs": {
      "$deptId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val().length >= 1"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "members": {
          "$uid": {
            ".validate": "newData.hasChildren(['role','displayName','joinedAt'])",
            "role": {
              ".validate": "newData.isString() && newData.val().length >= 1"
            },
            "displayName": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "viaCode": {
              ".validate": "!newData.exists() || (newData.isString())"
            },
            "$other": {
              ".validate": false
            },
            ".write": "auth != null && $uid === auth.uid && !data.exists() && newData.child('role').val() === 'default' && root.child('orgs').child('inviteCodes').child(newData.child('viaCode').val()).child('deptId').val() === $deptId && root.child('orgs').child('inviteCodes').child(newData.child('viaCode').val()).child('active').val() === true"
          }
        },
        "roles": {
          "$roleId": {
            ".validate": "newData.hasChildren(['name','permissions'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "builtIn": {
              ".validate": "!newData.exists() || (newData.isBoolean())"
            },
            "permissions": {
              ".validate": "newData.hasChildren(['read','runFieldWork','manageOperations','manageInventory','manageRoster','manageSettings','manageUsers','manageData'])",
              "read": {
                ".validate": "newData.isBoolean()"
              },
              "runFieldWork": {
                ".validate": "newData.isBoolean()"
              },
              "manageOperations": {
                ".validate": "newData.isBoolean()"
              },
              "manageInventory": {
                ".validate": "newData.isBoolean()"
              },
              "manageRoster": {
                ".validate": "newData.isBoolean()"
              },
              "manageSettings": {
                ".validate": "newData.isBoolean()"
              },
              "manageUsers": {
                ".validate": "newData.isBoolean()"
              },
              "manageData": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "inviteCodes": {
        "$code": {
          ".validate": "newData.hasChildren(['deptId','deptName','createdBy','createdAt','active'])",
          "deptId": {
            ".validate": "newData.isString() && newData.val().length >= 1"
          },
          "deptName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
          },
          "createdBy": {
            ".validate": "newData.isString() && newData.val().length >= 1"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "active": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null",
          ".write": "auth != null && !data.exists() && newData.child('createdBy').val() === auth.uid && root.child('orgs').child(newData.child('deptId').val()).child('createdBy').val() === auth.uid"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
