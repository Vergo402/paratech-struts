{
  "rules": {
    "departments": {
      "$deptId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || !data.child('members').exists())",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "members": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "inventory": {
          "$itemId": {
            ".validate": "newData.hasChildren(['model', 'quantity', 'available'])"
          }
        },
        "apparatus": {
          "$appId": {
            ".validate": "newData.hasChildren(['name', 'type'])"
          }
        },
        "operations": {
          ".indexOn": ["status"],
          "$opId": {
            ".validate": "newData.hasChild('name') && newData.hasChild('status')",
            "shorePoints": {
              "$spId": {
                "status": {
                  ".validate": "newData.isString() && newData.val().matches(/^(pending|process|strutplaced|cutting|runner|secured|returned)$/)"
                },
                "requiredLength": {
                  ".validate": "newData.isNumber() && newData.val() >= 12 && newData.val() <= 500"
                },
                "estimatedLoad": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000"
                },
                "label": {
                  ".validate": "newData.isString() && newData.val().length <= 200"
                }
              }
            },
            "roles": {
              "$targetId": {
                ".validate": "newData.isString() && newData.val().length <= 64"
              }
            }
          }
        }
      }
    },
    "feedback": {
      ".read": "auth != null",
      "$feedbackId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['category', 'text', 'timestamp'])",
        "image": {
          ".validate": "newData.isString() && newData.val().length < 500000"
        }
      }
    },
    "diagnostics": {
      "sync": {
        "$logId": {
          ".write": "auth != null",
          ".validate": "newData.hasChild('ts') && newData.hasChild('event')"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
