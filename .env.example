# Copy this file to .env.local and fill in the value. .env.local is gitignored.
# Restart the Vite dev server after changing env values (HMR won't pick them up).

# Google Maps "browser" API key for the operation address autocomplete
# (StartOperationModal → Location / address). Create it in the Google Cloud console
# on the fieldshore-database project (the one your Blaze plan is on):
#   1. APIs & Services → Library → enable "Places API (New)".
#   2. APIs & Services → Credentials → Create credentials → API key.
#   3. Restrict the key:
#        Application restrictions → HTTP referrers → add your dev + prod origins
#          (e.g. http://localhost:5199/*, http://*.local:5199/*, and your v4 URL).
#        API restrictions → restrict to "Places API (New)".
# A referrer-restricted browser key is safe to ship client-side (like the Firebase
# apiKey). Leave this unset and the address field stays a plain text box.
VITE_GOOGLE_MAPS_KEY=

# what3words API key (#441) — converts a shore point's GPS fix to its 3-word radio
# callout (accounts.what3words.com → API keys; restrict to your domains there).
# Leave unset and shore points simply carry coordinates without words.
VITE_W3W_KEY=
