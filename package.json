{
  "name": "fieldshore-v4",
  "private": true,
  "version": "4.0.0-slice.1",
  "type": "module",
  "description": "FieldShore v4 — USAR/FEMA rescue-strut + shoring PWA (vertical slice). v3 ships from the repo root; v4 lives under src/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:rules": "vite-node scripts/gen-rules.ts",
    "test:rules": "firebase emulators:exec --only database --project fieldshore-database \"vitest run --config vitest.rules.config.ts\""
  },
