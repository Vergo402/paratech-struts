    "@tanstack/react-router": "^1.87.0",
    "dexie": "^4.0.10",
    "firebase": "^12.15.0",
    "gsap": "^3.15.0",
    "jsqr": "^1.4.0",
    "lenis": "^1.3.25",
    "qrcode": "^1.5.4",
